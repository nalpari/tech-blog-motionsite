---
// GitHub 아바타. 올리면 이름·설명 카드, 누르면 GitHub 프로필로.
import { AUTHOR } from '../site';

interface Props {
	size?: number;
	showName?: boolean;
}
const { size = 40, showName = false } = Astro.props;
---

<a class="author" href={AUTHOR.url} target="_blank" rel="noopener noreferrer" aria-label={`${AUTHOR.name} GitHub 프로필`} style={`--s:${size}px`}>
	<img class="av" src={AUTHOR.avatar} alt="" width={size} height={size} loading="lazy" />
	{showName && <span class="name">{AUTHOR.name}<small>@{AUTHOR.login}</small></span>}
	<span class="card" aria-hidden="true">
		<img src={AUTHOR.avatar} alt="" width="48" height="48" loading="lazy" />
		<strong>{AUTHOR.name}</strong>
		<small>@{AUTHOR.login}</small>
		<span class="bio">{AUTHOR.bio}</span>
		<span class="label">GitHub ↗</span>
	</span>
</a>

<style>
	.author { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 12px; }
	.av { width: var(--s); height: var(--s); border-radius: 50%; background: hsl(var(--fg) / .08); box-shadow: 0 0 0 1px var(--line); transition: box-shadow .2s; }
	.author:hover .av, .author:focus-visible .av { box-shadow: 0 0 0 1.5px var(--accent); }
	.name { font-size: 14px; font-weight: 500; }
	.name small { display: block; font-size: 12px; font-weight: 400; color: hsl(var(--fg) / .45); }

	.card {
		position: absolute; left: 0; bottom: calc(100% + 12px); z-index: 50;
		display: grid; grid-template-columns: 48px 1fr; column-gap: 12px; align-items: center;
		width: 260px; padding: 16px; border-radius: 16px;
		background: var(--raised); box-shadow: 0 24px 48px var(--shadow), 0 0 0 1px hsl(var(--fg) / .12);
		text-align: left; white-space: normal;
		opacity: 0; visibility: hidden; translate: 0 6px;
		transition: opacity .2s var(--ease), translate .2s var(--ease), visibility .2s;
	}
	/* 아바타와 카드 사이 틈을 지나도 hover 가 끊기지 않게 */
	.card::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 12px; }
	.card img { grid-row: span 2; width: 48px; height: 48px; border-radius: 50%; }
	.card strong { font-size: 15px; font-weight: 600; align-self: end; }
	.card small { font-size: 12px; color: hsl(var(--fg) / .45); align-self: start; }
	.card .bio, .card .label { grid-column: 1 / -1; }
	.card .bio { margin-top: 12px; font-size: 13.5px; line-height: 1.6; color: hsl(var(--fg) / .7); }
	.card .label { margin-top: 12px; }
	.author:hover .card, .author:focus-visible .card { opacity: 1; visibility: visible; translate: 0 0; }
</style>
