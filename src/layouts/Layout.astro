---
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}
const { title, description = SITE.description, image = '/media/hero-poster.jpg' } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.org} Blog`;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#060607" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" />
		<script is:inline>
			// CSS 페인트 전에 테마를 정한다(깜빡임 방지). 저장값 > OS 설정 순. 저장값이 없으면 OS 변경도 따라간다.
			(() => {
				const d = document.documentElement;
				const mq = matchMedia('(prefers-color-scheme: light)');
				const saved = () => { try { return localStorage.getItem('theme'); } catch { return null; } };
				const apply = (t) => {
					d.dataset.theme = t;
					document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'light' ? '#f6f4ef' : '#060607');
					document.dispatchEvent(new CustomEvent('themechange', { detail: t }));
				};
				d.classList.add('js');
				const s = saved();
				apply(s === 'light' || s === 'dark' ? s : mq.matches ? 'light' : 'dark');
				mq.addEventListener('change', (e) => { if (!saved()) apply(e.matches ? 'light' : 'dark'); });
				// 토글 버튼은 아직 파싱 전이므로 위임으로 받는다
				document.addEventListener('click', (e) => {
					if (!e.target.closest?.('[data-theme-toggle]')) return;
					const t = d.dataset.theme === 'light' ? 'dark' : 'light';
					try { localStorage.setItem('theme', t); } catch {}
					apply(t);
				});
			})();
		</script>
	</head>
	<body>
		<header class="nav" data-nav>
			<div class="nav-inner glass">
				<a href="/" class="mark" aria-label={`${SITE.name} 홈`}>
					<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><rect x="5" y="0" width="8" height="18" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M9 3v4.5L7 10v5" stroke="#ff5b1f" stroke-width="1.4" fill="none"/></svg>
					<span>{SITE.name}</span>
				</a>
				<nav class="links" aria-label="주요 메뉴">
					<a href="/#index">Articles</a>
					<a href="/#featured">Featured</a>
				</nav>
				<div class="tools">
					<span class="clock label" aria-label="서울 현재 시각"><span class="dot"></span> SEOUL <time data-clock>--:--</time></span>
					<button type="button" class="theme-toggle" data-theme-toggle aria-label="테마 전환">
						<svg class="sun" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="8" cy="8" r="3"/><path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06"/></svg>
						<svg class="moon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z"/></svg>
					</button>
				</div>
			</div>
		</header>

		<slot />

		<footer class="foot">
			<div class="wrap">
				<div class="foot-row">
					<p class="foot-line">코드를 쓴 사람이 직접 씁니다.<br /><span>{SITE.org} 팀의 실험과 실패, 그리고 그다음의 기록.</span></p>
					<a class="to-top label" href="#top">Back to top ↑</a>
				</div>
				<p class="wordmark" aria-hidden="true">{SITE.name}</p>
				<div class="foot-meta label">
					<span>© {new Date().getFullYear()} {SITE.org}</span>
					<span>Internal tech journal</span>
				</div>
			</div>
		</footer>

		<div class="grain" aria-hidden="true"></div>

		<script>
			// nav glass after scroll
			const nav = document.querySelector('[data-nav]');
			// 히어로가 nav(84px) 뒤로 다 지나가면 past-hero: 그 전까지 nav 는 다크 토큰을 쓴다
			const hero = document.querySelector('[data-hero]');
			const onScroll = () => {
				nav?.classList.toggle('scrolled', scrollY > 40);
				nav?.classList.toggle('past-hero', !!hero && hero.getBoundingClientRect().bottom <= 84);
			};
			addEventListener('scroll', onScroll, { passive: true });
			onScroll();

			// 테마 토글 라벨을 현재 상태에 맞춘다 (전환 자체는 head 인라인 스크립트가 처리)
			const toggle = document.querySelector('[data-theme-toggle]');
			const syncToggle = () => toggle?.setAttribute('aria-label', document.documentElement.dataset.theme === 'light' ? '다크 모드로 전환' : '라이트 모드로 전환');
			document.addEventListener('themechange', syncToggle);
			syncToggle();

			// live Seoul clock
			const clock = document.querySelector('[data-clock]');
			const tick = () => {
				if (clock) clock.textContent = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Seoul' }).format(new Date());
			};
			tick();
			setInterval(tick, 15000);

			// in-view reveals
			const io = new IntersectionObserver((entries) => {
				for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
			}, { threshold: 0.15 });
			document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
		</script>
	</body>
</html>

<style>
	.nav {
		position: fixed; top: 0; left: 0; right: 0; z-index: 20;
		padding: 16px var(--gutter);
		color: hsl(var(--fg));
		animation: fade .8s var(--ease) both;
	}
	.nav-inner {
		max-width: var(--max); margin: 0 auto;
		display: flex; align-items: center; justify-content: space-between; gap: 24px;
		height: 52px; padding: 0 10px 0 18px; border-radius: 999px;
		background: transparent; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none;
		transition: background .35s var(--ease), box-shadow .35s var(--ease), backdrop-filter .35s var(--ease);
	}
	/* top scrim: content fades out before it reaches the nav */
	.nav::before {
		content: ''; position: absolute; inset: 0 0 -40px; z-index: -1; pointer-events: none;
		background: linear-gradient(to bottom, var(--bg) 0%, color-mix(in srgb, var(--bg) 85%, transparent) 50%, transparent 100%);
		opacity: 0; transition: opacity .35s var(--ease);
	}
	.nav.scrolled::before { opacity: 1; }
	.nav.scrolled .nav-inner {
		background: var(--nav-bg);
		backdrop-filter: blur(28px) saturate(160%) brightness(var(--nav-brightness));
		-webkit-backdrop-filter: blur(28px) saturate(160%) brightness(var(--nav-brightness));
		box-shadow: inset 0 1px 0 hsl(var(--fg) / .08), 0 0 0 1px hsl(var(--fg) / .08);
	}
	.mark { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px; letter-spacing: .14em; }
	.links { display: flex; gap: 6px; }
	.links a {
		font-size: 14px; color: hsl(var(--fg) / .7);
		padding: 8px 16px; border-radius: 999px;
		transition: color .2s, background .2s;
	}
	.links a:hover { color: hsl(var(--fg)); background: hsl(var(--fg) / .07); }
	.tools { display: flex; align-items: center; gap: 4px; }
	.clock { display: inline-flex; align-items: center; gap: 8px; padding-right: 10px; font-variant-numeric: tabular-nums; }
	.theme-toggle {
		display: grid; place-items: center; width: 36px; height: 36px; padding: 0; border: 0; border-radius: 999px; cursor: pointer;
		background: transparent; color: hsl(var(--fg) / .7);
		transition: color .2s, background .2s;
	}
	.theme-toggle:hover { color: hsl(var(--fg)); background: hsl(var(--fg) / .07); }
	/* 지금 테마의 반대(전환될 테마) 아이콘을 보인다 */
	.theme-toggle .moon, :global(:root[data-theme='light']) .theme-toggle .sun { display: none; }
	:global(:root[data-theme='light']) .theme-toggle .moon { display: block; }
	@media (max-width: 640px) {
		.clock { display: none; }
		.links a { padding: 8px 12px; }
	}

	.foot { margin-top: clamp(120px, 16vw, 200px); border-top: 1px solid var(--line); padding: 64px 0 32px; overflow: hidden; }
	.foot-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
	.foot-line { margin: 0; font-size: clamp(20px, 2.2vw, 28px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.35; }
	.foot-line span { color: hsl(var(--fg) / .45); }
	.to-top { transition: color .2s; }
	.to-top:hover { color: hsl(var(--fg)); }
	.wordmark {
		margin: clamp(48px, 8vw, 96px) 0 0;
		font-size: clamp(64px, 21.5vw, 300px);
		font-weight: 700; letter-spacing: -0.06em; line-height: .78;
		color: transparent;
		-webkit-text-stroke: 1px hsl(var(--fg) / .16);
		white-space: nowrap; user-select: none;
	}
	.foot-meta { display: flex; justify-content: space-between; margin-top: 32px; }
</style>
