---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { CATEGORIES, SITE, formatDate, readingMinutes } from '../site';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const counts = Object.fromEntries(Object.keys(CATEGORIES).map((c) => [c, posts.filter((p) => p.data.category === c).length]));
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout>
	<section class="hero" data-hero>
		<div class="hero-media" data-parallax aria-hidden="true">
			<video autoplay muted loop playsinline preload="auto" poster="/media/hero-poster.jpg" data-hero-video>
				<source src="/media/hero.mp4" type="video/mp4" />
			</video>
		</div>
		<div class="hero-fade" aria-hidden="true"></div>

		<div class="wrap hero-content">
			<p class="label hero-eyebrow"><span class="dot"></span> {SITE.org} Journal · Vol. {new Date().getFullYear()}</p>
			<h1>
				<span class="line-mask"><span style="--d:.15s">운영하며 배운 것을</span></span>
				<span class="line-mask"><span style="--d:.27s">숨기지 않고 <em>씁니다.</em></span></span>
			</h1>
			<p class="hero-sub">{SITE.description}</p>
			<div class="hero-actions">
				<a class="btn" href={`/posts/${featured.id}/`}>최신 글 읽기 <span class="btn-arrow" aria-hidden="true">→</span></a>
				<a class="ghost" href="#index">전체 아카이브</a>
			</div>
		</div>

		<div class="wrap hero-strip label">
			<span>{pad(posts.length)} Articles</span>
			<span>{pad(Object.keys(CATEGORIES).length)} Teams</span>
			<span>Updated {formatDate(posts[0].data.date)}</span>
			<span class="scroll-cue">Scroll ↓</span>
		</div>
	</section>

	<section class="wrap featured" id="featured">
		<p class="label reveal">Featured — 이번 주의 글</p>
		<a class="feat-card reveal" href={`/posts/${featured.id}/`} style="--d:.08s">
			<div class="feat-media">
				<img src={featured.data.cover} alt="" loading="lazy" width="1200" height="904" />
			</div>
			<div class="feat-body">
				<span class="label">{CATEGORIES[featured.data.category]} · {readingMinutes(featured.body)} min read</span>
				<h2>{featured.data.title}</h2>
				<p>{featured.data.description}</p>
				<div class="byline">
					<span class="avatar" aria-hidden="true">{featured.data.author.slice(0, 1)}</span>
					<span>{featured.data.author}<small>{featured.data.role}</small></span>
					<span class="go" aria-hidden="true">↗</span>
				</div>
			</div>
		</a>
	</section>

	<section class="wrap index" id="index">
		<div class="index-head reveal">
			<h2>Index <em>of everything</em><sup>{pad(posts.length)}</sup></h2>
			<div class="filters" role="group" aria-label="카테고리 필터">
				<button type="button" class="chip" aria-pressed="true" data-filter="all">All</button>
				{Object.entries(CATEGORIES).map(([key, label]) => (
					<button type="button" class="chip" aria-pressed="false" data-filter={key}>{label}<sup>{counts[key]}</sup></button>
				))}
			</div>
		</div>

		<ol class="rows" data-rows>
			{posts.map((post, i) => (
				<li class="row reveal" data-cat={post.data.category} style={`--d:${i * 0.06}s`}>
					<a href={`/posts/${post.id}/`} data-cover={post.data.cover}>
						<span class="no">{pad(i + 1)}</span>
						<span class="cat label">{CATEGORIES[post.data.category]}</span>
						<span class="title">
							{post.data.title}
							<small>{post.data.description}</small>
						</span>
						<span class="who">{post.data.author}</span>
						<time class="when label" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
						<img class="thumb" src={post.data.cover} alt="" loading="lazy" width="120" height="90" />
					</a>
				</li>
			))}
		</ol>
	</section>

	<div class="preview" data-preview aria-hidden="true"><img src={featured.data.cover} alt="" /></div>
</Layout>

<script>
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const fine = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)').matches;

	// hero video: fade in once frames are ready
	const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
	if (video) {
		const show = () => video.classList.add('ready');
		video.readyState >= 2 ? show() : video.addEventListener('loadeddata', show, { once: true });
	}

	// hero pointer parallax (lerp .12)
	const media = document.querySelector<HTMLElement>('[data-parallax]');
	if (media && fine && !reduce) {
		let tx = 0, ty = 0, x = 0, y = 0;
		addEventListener('pointermove', (e) => {
			tx = (e.clientX / innerWidth - 0.5) * -24;
			ty = (e.clientY / innerHeight - 0.5) * -16;
		});
		const loop = () => {
			x += (tx - x) * 0.12;
			y += (ty - y) * 0.12;
			media.style.transform = `translate3d(${x}px, ${y}px, 0) scale(1.06)`;
			requestAnimationFrame(loop);
		};
		loop();
	}

	// category filter
	const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const rows = document.querySelectorAll<HTMLElement>('[data-rows] .row');
	chips.forEach((chip) =>
		chip.addEventListener('click', () => {
			const f = chip.dataset.filter;
			chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
			rows.forEach((r) => (r.hidden = f !== 'all' && r.dataset.cat !== f));
		}),
	);

	// cursor-following cover preview (desktop pointer only)
	const preview = document.querySelector<HTMLElement>('[data-preview]');
	const img = preview?.querySelector('img');
	if (preview && img && fine) {
		let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
		const k = reduce ? 1 : 0.14;
		const loop = () => {
			x += (tx - x) * k;
			y += (ty - y) * k;
			preview.style.transform = `translate3d(${x}px, ${y}px, 0)`;
			raf = requestAnimationFrame(loop);
		};
		document.querySelectorAll<HTMLAnchorElement>('[data-cover]').forEach((a) => {
			a.addEventListener('pointerenter', (e) => {
				img.src = a.dataset.cover!;
				if (!preview.classList.contains('on')) { x = tx = e.clientX; y = ty = e.clientY; }
				preview.classList.add('on');
				if (!raf) loop();
			});
			a.addEventListener('pointermove', (e) => { tx = e.clientX; ty = e.clientY; });
			a.addEventListener('pointerleave', () => preview.classList.remove('on'));
		});
		document.querySelector('[data-rows]')?.addEventListener('pointerleave', () => { cancelAnimationFrame(raf); raf = 0; });
	}
</script>

<style>
	/* ---------- hero ---------- */
	.hero {
		position: relative;
		height: 100vh; height: 100dvh; min-height: 640px;
		display: flex; flex-direction: column; justify-content: flex-end;
		overflow: hidden;
	}
	.hero-media { position: absolute; inset: -2% -14% -2% 26%; z-index: 0; will-change: transform; transform: scale(1.06); }
	.hero-media video {
		width: 100%; height: 100%; object-fit: cover; object-position: 50% center;
		opacity: 0; animation: settle 1.8s var(--ease) both;
	}
	.hero-media video.ready { opacity: 1; transition: opacity .6s ease; }
	@keyframes settle { from { scale: 1.06; } }
	.hero-fade {
		position: absolute; inset: 0; z-index: 1; pointer-events: none;
		background:
			linear-gradient(to right, #060607 0%, #060607 24%, rgba(6,6,7,.6) 34%, transparent 50%),
			linear-gradient(to bottom, rgba(6,6,7,.5) 0%, transparent 18%, transparent 55%, #060607 100%);
	}
	.hero-content { position: relative; z-index: 10; padding-bottom: clamp(40px, 7vh, 88px); }
	.hero-eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 28px; color: hsl(var(--fg) / .65); animation: up .9s var(--ease) both .05s; }
	h1 {
		margin: 0;
		font-size: clamp(42px, 6.6vw, 96px);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.055em;
		text-shadow: 0 16px 38px rgba(0,0,0,.32);
	}
	h1 em {
		font-style: normal;
		color: hsl(var(--fg) / .5);
	}
	.hero-sub {
		max-width: 30rem; margin: 28px 0 0;
		font-size: clamp(15px, 1.2vw, 17px); line-height: 1.65;
		color: hsl(var(--fg) / .62);
		animation: up .9s var(--ease) both .45s;
	}
	.hero-actions { display: flex; align-items: center; gap: 28px; margin-top: 36px; animation: up .9s var(--ease) both .58s; }
	.btn {
		display: inline-flex; align-items: center; gap: 12px;
		padding: 8px 8px 8px 24px; border-radius: 999px;
		background: hsl(var(--fg)); color: #060607;
		font-size: 15px; font-weight: 600;
		transition: transform .25s var(--ease);
	}
	.btn:hover { transform: scale(1.03); }
	.btn:active { transform: scale(.97); }
	.btn-arrow {
		display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
		background: #060607; color: hsl(var(--fg));
		transition: transform .3s var(--ease);
	}
	.btn:hover .btn-arrow { transform: rotate(-45deg); }
	.ghost { font-size: 15px; font-weight: 500; color: hsl(var(--fg) / .8); border-bottom: 1px solid hsl(var(--fg) / .25); padding-bottom: 3px; transition: color .2s, border-color .2s; }
	.ghost:hover { color: hsl(var(--fg)); border-color: var(--accent); }
	.hero-strip {
		position: relative; z-index: 10;
		display: flex; gap: 32px;
		padding-top: 20px; padding-bottom: max(24px, env(safe-area-inset-bottom));
		border-top: 1px solid var(--line);
		animation: fade 1.1s ease both .8s;
	}
	.scroll-cue { margin-left: auto; }

	/* ---------- featured ---------- */
	.featured { padding-top: clamp(96px, 12vw, 160px); }
	.feat-card {
		display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(24px, 4vw, 64px); align-items: center;
		margin-top: 28px; padding: 14px; border-radius: 28px;
		background: var(--raised); box-shadow: 0 0 0 1px var(--line);
		transition: box-shadow .4s var(--ease);
	}
	.feat-card:hover { box-shadow: 0 0 0 1px hsl(var(--fg) / .2); }
	.feat-media { aspect-ratio: 4 / 3; border-radius: 18px; overflow: hidden; background: #000; }
	.feat-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .9s var(--ease); }
	.feat-card:hover .feat-media img { transform: scale(1.05); }
	.feat-body { padding: 16px clamp(8px, 2vw, 32px) 16px 0; }
	.feat-body h2 { margin: 20px 0 0; font-size: clamp(28px, 3.4vw, 48px); font-weight: 500; line-height: 1.15; letter-spacing: -0.045em; }
	.feat-body p { margin: 20px 0 0; max-width: 32rem; color: hsl(var(--fg) / .6); line-height: 1.7; }
	.byline { display: flex; align-items: center; gap: 12px; margin-top: 40px; font-size: 14px; font-weight: 500; }
	.byline small { display: block; font-size: 12px; font-weight: 400; color: hsl(var(--fg) / .45); }
	.avatar { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: hsl(var(--fg) / .08); font-size: 14px; }
	.go {
		margin-left: auto; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
		box-shadow: 0 0 0 1px hsl(var(--fg) / .2); font-size: 18px;
		transition: background .3s var(--ease), color .3s var(--ease), transform .3s var(--ease);
	}
	.feat-card:hover .go { background: hsl(var(--fg)); color: #060607; transform: rotate(45deg); }

	/* ---------- index ---------- */
	.index { padding-top: clamp(120px, 14vw, 200px); }
	.index-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; padding-bottom: 32px; }
	.index-head h2 { margin: 0; font-size: clamp(48px, 8vw, 120px); font-weight: 500; letter-spacing: -0.06em; line-height: .9; }
	.index-head h2 em { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em; color: hsl(var(--fg) / .45); }
	.index-head sup { font-family: var(--mono); font-size: 13px; letter-spacing: 0; color: var(--accent); vertical-align: top; margin-left: 6px; }
	.filters { display: flex; flex-wrap: wrap; gap: 8px; }
	.chip {
		font: 500 13px/1 var(--sans); color: hsl(var(--fg) / .7);
		min-height: 40px; padding: 0 16px; border-radius: 999px; border: 0; cursor: pointer;
		background: transparent; box-shadow: inset 0 0 0 1px hsl(var(--fg) / .14);
		transition: color .2s, background .2s, box-shadow .2s;
	}
	.chip sup { font-family: var(--mono); font-size: 9px; margin-left: 3px; opacity: .6; }
	.chip:hover { color: hsl(var(--fg)); box-shadow: inset 0 0 0 1px hsl(var(--fg) / .35); }
	.chip[aria-pressed='true'] { background: hsl(var(--fg)); color: #060607; box-shadow: none; }

	.rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
	.row { border-bottom: 1px solid var(--line); }
	.row a {
		position: relative;
		display: grid; grid-template-columns: 64px 120px 1fr 120px 110px; align-items: baseline; gap: 24px;
		padding: 34px 8px;
		transition: background .35s var(--ease);
	}
	.no { font-family: var(--serif); font-style: italic; font-size: 28px; line-height: 1; color: hsl(var(--fg) / .35); transition: color .3s; }
	.title {
		font-size: clamp(22px, 2.5vw, 36px); font-weight: 500; line-height: 1.25; letter-spacing: -0.04em;
		transition: transform .45s var(--ease);
	}
	.title small {
		display: block; max-width: 40rem; margin-top: 10px;
		font-size: 14.5px; font-weight: 400; letter-spacing: -0.01em; line-height: 1.6; color: hsl(var(--fg) / .5);
	}
	.who { font-size: 14px; color: hsl(var(--fg) / .7); }
	.when { text-align: right; font-variant-numeric: tabular-nums; }
	.thumb { display: none; }
	.row a:hover { background: hsl(var(--fg) / .025); }
	.row a:hover .title { transform: translateX(14px); }
	.row a:hover .no { color: var(--accent); }

	.preview {
		position: fixed; left: 0; top: 0; z-index: 30; pointer-events: none;
		width: 300px; aspect-ratio: 4 / 3; margin: -110px 0 0 32px;
		border-radius: 16px; overflow: hidden;
		box-shadow: 0 30px 60px rgba(0,0,0,.5), 0 0 0 1px hsl(var(--fg) / .1);
		opacity: 0;
	}
	.preview img { width: 100%; height: 100%; object-fit: cover; scale: .86; transition: scale .5s var(--ease); }
	.preview.on { opacity: 1; transition: opacity .25s ease; }
	.preview.on img { scale: 1; }

	/* ---------- responsive ---------- */
	@media (max-width: 1023px) {
		.row a { grid-template-columns: 44px 1fr 96px; grid-template-areas: 'no cat thumb' 'no title thumb' 'no meta thumb'; gap: 6px 16px; align-items: start; padding: 24px 0; }
		.no { grid-area: no; font-size: 22px; }
		.cat { grid-area: cat; }
		.title { grid-area: title; font-size: 20px; }
		.title small { display: none; }
		.who { grid-area: meta; font-size: 13px; }
		.when { display: none; }
		.thumb { grid-area: thumb; display: block; width: 96px; height: 72px; object-fit: cover; border-radius: 10px; }
		.row a:hover .title { transform: none; }
		.feat-card { grid-template-columns: 1fr; }
		.feat-body { padding: 8px 12px 16px; }
	}
	@media (max-width: 640px) {
		.hero-media { inset: -2% -40% 30% -10%; }
		.hero-media video { object-position: 55% center; }
		.hero-fade {
			background: linear-gradient(to bottom, rgba(6,6,7,.55) 0%, rgba(6,6,7,.2) 30%, rgba(6,6,7,.7) 62%, #060607 100%);
		}
		.hero-strip { gap: 18px; font-size: 10px; }
		.hero-strip span:nth-child(3) { display: none; }
		.hero-actions { gap: 20px; }
	}
	@media (max-height: 720px) and (min-width: 641px) {
		h1 { font-size: clamp(40px, 6vw, 84px); }
		.hero-sub { margin-top: 18px; }
		.hero-actions { margin-top: 24px; }
	}
</style>
